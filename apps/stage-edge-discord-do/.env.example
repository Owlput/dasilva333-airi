# Discord Bot Configuration
# 1. Obtain from https://discord.com/developers/applications
# 2. Under Bot tab, make sure "MESSAGE CONTENT INTENT" is ENABLED under Privileged Gateway Intents!
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# (Optional) Application ID
DISCORD_APPLICATION_ID=""

# Auto-connect to Discord Gateway when the worker is invoked
AUTO_CONNECT="true"

# (Optional) Restrict responses to a specific channel ID (leave empty to respond in any channel the bot can see)
ALLOWED_CHANNEL_ID=""
